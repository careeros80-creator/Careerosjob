{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "career-os/events/application.sent/v1",
  "$comment": "version: 1.0",
  "title": "application.sent",
  "description": "Emitted by Application Context after Gmail send succeeds",
  "type": "object",
  "required": [
    "event",
    "version",
    "event_id",
    "correlation_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "const": "application.sent"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "application_id",
        "job_id",
        "company_id",
        "gmail_message_id",
        "gmail_thread_id",
        "sent_to",
        "channel",
        "sent_at",
        "followup_scheduled"
      ],
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "company_id": {
          "type": "string",
          "format": "uuid"
        },
        "gmail_message_id": {
          "type": "string"
        },
        "gmail_thread_id": {
          "type": "string"
        },
        "sent_to": {
          "type": "string",
          "format": "email"
        },
        "channel": {
          "type": "string",
          "enum": [
            "gmail",
            "linkedin",
            "jobbank",
            "company_form",
            "indeed",
            "manual",
            "other"
          ]
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "followup_scheduled": {
          "type": "object",
          "required": [
            "day_7",
            "day_14",
            "day_21"
          ],
          "additionalProperties": false,
          "properties": {
            "day_7": {
              "type": "string",
              "format": "date-time"
            },
            "day_14": {
              "type": "string",
              "format": "date-time"
            },
            "day_21": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
