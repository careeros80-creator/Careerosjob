{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "career-os/events/job.scored/v1",
  "$comment": "version: 1.0",
  "title": "job.scored",
  "description": "Emitted by Scoring Context after Rule Engine + AI scoring",
  "type": "object",
  "required": [
    "event",
    "version",
    "event_id",
    "correlation_id",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "const": "job.scored"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "job_id",
        "score",
        "priority",
        "score_breakdown",
        "lmia_required",
        "passed_rules",
        "scored_at"
      ],
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "ignore"
          ]
        },
        "score_breakdown": {
          "type": "object",
          "required": [
            "language",
            "experience",
            "visa",
            "salary",
            "province",
            "recency"
          ],
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "experience": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            },
            "visa": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "salary": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "province": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "recency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "lmia_required": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "c16_possible",
            "unknown"
          ]
        },
        "passed_rules": {
          "type": "boolean"
        },
        "failed_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_call_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "scored_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
