{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "career-os/events/job.cleaned/v1",
  "title": "job.cleaned",
  "description": "Emitted by Normalization Context after successful cleaning and parsing",
  "type": "object",
  "required": [
    "event",
    "version",
    "payload",
    "event_id",
    "correlation_id"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "const": "job.cleaned"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "payload": {
      "type": "object",
      "required": [
        "job_id",
        "raw_job_id",
        "content_hash",
        "parser_version",
        "is_duplicate"
      ],
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "raw_job_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_hash": {
          "type": "string",
          "format": "uuid"
        },
        "parser_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semver: 1.0.0"
        },
        "is_duplicate": {
          "type": "boolean"
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID for idempotency — checked before processing"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Groups all events from one pipeline run"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "event_id of the event that triggered this one"
    }
  },
  "$comment": "version: 1.0"
}
