{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "career-os/ai/writer/v1",
  "title": "AI Writer Output",
  "description": "Output contract for AI role: writer. Generates Cover Letter + Email using Claude.",
  "type": "object",
  "required": [
    "cover_letter",
    "email"
  ],
  "additionalProperties": false,
  "properties": {
    "cover_letter": {
      "type": "object",
      "required": [
        "language",
        "subject",
        "body",
        "word_count",
        "mobilite_francophone_mentioned"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "fr",
            "en"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 5
        },
        "body": {
          "type": "string",
          "minLength": 100
        },
        "word_count": {
          "type": "integer",
          "minimum": 50
        },
        "mobilite_francophone_mentioned": {
          "type": "boolean"
        }
      }
    },
    "email": {
      "type": "object",
      "required": [
        "subject",
        "body",
        "tone"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 5
        },
        "body": {
          "type": "string",
          "minLength": 50
        },
        "tone": {
          "type": "string",
          "enum": [
            "professional",
            "warm",
            "formal"
          ]
        }
      }
    }
  },
  "$comment": "version: 1.0"
}
